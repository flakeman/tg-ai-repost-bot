# Telegram Bot Credentials
BOT_TOKEN=your_telegram_bot_token_here
CHANNEL_ID=@your_channel_or_channel_id
ADMIN_IDS=12345678,87654321

# Storage
DB_PATH=storage/bot.db

# LLM Providers (DeepSeek & OpenAI)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
PRIMARY_LLM_PROVIDER=deepseek
FALLBACK_LLM_PROVIDER=openai

# Image Generation
IMAGE_PROVIDER=mock
DALLE_MODEL=dall-e-3
IMAGE_STYLE="modern minimalist, high quality digital editorial illustration, vibrant accents"

# Tone Defaults (dynamic / casual / formal / analytical)
DEFAULT_TONE=dynamic
